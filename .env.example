# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mace

# Auth - ganti dengan string acak yang panjang
JWT_SECRET=random_secret_string

# Frontend - dibaca saat `npm run build`. Untuk VPS/produksi biarkan /api (same-origin)
VITE_API_URL=/api

# Port server produksi (node server.js)
PORT=3001
